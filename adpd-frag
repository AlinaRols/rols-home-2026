    Array.prototype.forEach.call(g.querySelectorAll('[data-galeria-ir]'), function (b) {
      b.addEventListener('click', function () { u.scrollTo({ left: +b.getAttribute('data-galeria-ir') * u.clientWidth, behavior: 'smooth' }); });
    });
    // Las flechitas de los lados, como en las fichas: dan la vuelta.
    var n0 = rayas.length;
    var pasa = function (dir) {
      var n = (Math.round(u.scrollLeft / u.clientWidth) + dir + n0) % n0;
      u.scrollTo({ left: n * u.clientWidth, behavior: 'smooth' });
    };
    var a = g.querySelector('[data-galeria-prev]'), b = g.querySelector('[data-galeria-next]');
    if (a) a.addEventListener('click', function () { pasa(-1); });
    if (b) b.addEventListener('click', function () { pasa(1); });
    u.addEventListener('scroll', function () {
      var n = Math.round(u.scrollLeft / u.clientWidth);
      rayas.forEach(function (r, i) {
        r.classList.toggle('bg-foreground/70', i === n);
        r.classList.toggle('bg-foreground/15', i !== n);
        r.classList.toggle('group-hover/raya:bg-foreground/35', i !== n);
      });
    }, { passive: true });
  });
  // Flechas de las tiras.
  var tiras = Array.prototype.filter.call(document.querySelectorAll('main ul'), function (u) {
    return getComputedStyle(u).overflowX === 'auto' && !u.closest('[data-galeria]');
  });
  // Solo las flechas: los puntitos del carrusel de proyectos tambien son
  // botones con etiqueta, y si entran aqui descuadran el emparejamiento por
  // orden. Las flechas son las que llevan un svg dentro.
  var botones = Array.prototype.filter.call(
    document.querySelectorAll('main button[aria-label]'),
    // El play del video (video-cover.tsx) tambien es un boton con svg y
    // etiqueta: fuera, o descuadra el emparejamiento (Interioristas).
    // Tampoco los del visor de fotos (data-lb): tiene flechas y cierre con svg.
    function (b) { return !!b.querySelector('svg') && !b.hasAttribute('data-video-play') && !b.closest('[data-lb]') && !b.closest('[data-galeria]'); });
  tiras.forEach(function (tira, i) {
    var par = botones.slice(i * 2, i * 2 + 2);
    // Tira sin fin (data-loop): las fichas van tres veces -copia, originales,
    // copia- y al meterse en una copia se salta una tanda hacia atras o
