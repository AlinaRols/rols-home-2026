      // a la derecha cuando se ve el ambiente.
      var tramo = boton.querySelector('[data-mobile-bar]');
      if (tramo) { tramo.classList.toggle('translate-x-full', activa); tramo.classList.toggle('translate-x-0', !activa); }
    };

