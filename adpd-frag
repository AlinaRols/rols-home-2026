:root {
  --background: #fff;
  --surface: #f7f3f0;
  --surface-deep: #efe9e4;
  --surface-warm: #ebe4e4;
  --beige: #ede2d6;
  --foreground: #333a3c;
  --accent: #d5b38c;
  --accent-deep: #b9906a;
  --line: var(--foreground);
}

@supports (color: color-mix(in lab, red, red)) {
  :root {
    --line: color-mix(in srgb, var(--foreground) 14%, transparent);
  }
}

:root {
  --cabecera: 62px;
}

@media (min-width: 1024px) {
  :root {
    --cabecera: 84px;
  }
}

* {
  box-sizing: border-box;
}

html {
  background: var(--background);
  scroll-behavior: smooth;
}

body {
  background: var(--background);
  min-height: 100vh;
  color: var(--foreground);
  margin: 0;
}

::selection {
  background: var(--accent);
  color: var(--foreground);
}

