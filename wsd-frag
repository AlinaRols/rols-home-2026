      // foto siguiente, no a la que ya se ve (rug-model-card.tsx, Alina 15/10/2026).
      var pasa = function (d) {
        if (d === 1 && foto === 0 && n() > 2 && ficha.querySelector('[data-rug-ambient]') && window.matchMedia('(min-width: 768px)').matches) d = 2;
