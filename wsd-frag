        lista.classList.toggle('hidden', !si);
        // Al abrir, la columna aparta las fichas: las clases de cada estado
        // vienen en data-clases-abierto / data-clases-cerrado.
        Array.prototype.forEach.call(document.querySelectorAll('[data-clases-abierto]'), function (el) {
          var quita = el.getAttribute(si ? 'data-clases-cerrado' : 'data-clases-abierto').split(' ');
          var pon = el.getAttribute(si ? 'data-clases-abierto' : 'data-clases-cerrado').split(' ');
          quita.forEach(function (c) { if (c) el.classList.remove(c); });
          pon.forEach(function (c) { if (c) el.classList.add(c); });
        });
        var galon = movil.querySelector('svg');
        if (galon) galon.classList.toggle('rotate-180', si);
      });
    }
    var barra = (botones[0] && botones[0].closest('div.relative')) || document.body;
    if (botones.length) document.addEventListener('pointerdown', function (e) {
      if (!barra.contains(e.target)) botones.forEach(function (o) { abre(o, false); });
    });
    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') botones.forEach(function (o) { abre(o, false); });
    });
    casillas.forEach(function (c) { c.addEventListener('change', pinta); });
    if (editions) editions.addEventListener('click', function () { conEd = !conEd; pinta(); });
    borrar.forEach(function (b) {
      b.addEventListener('click', function () {
        casillas.forEach(function (c) { c.checked = false; });
        conEd = false; pinta();
      });
    });
  })();
});
</script>
<script>// La bandeja de muestras (como la de Ernesta, adaptada a Rols): hasta 5
// referencias, guardadas en el navegador para que sigan al cambiar de pagina.
// Va en JavaScript suelto -y no en React- para que la copia estatica del
// enlace publico use exactamente el mismo codigo (captura.py lo incrusta).
//
// Todo el texto y el marcado vienen de la pagina (sample-tray.tsx): aqui solo
// se clonan las plantillas <template> y se rellenan. Los botones de anadir
// llevan data-sample-add con data-sample-id / -name / -img.
(function () {
  if (window.__rolsMuestras) return;
  window.__rolsMuestras = true;
  var CLAVE = "rols-muestras";

  function lee() {
    try {
      var v = JSON.parse(localStorage.getItem(CLAVE) || "[]");
      return Array.isArray(v) ? v : [];
    } catch (e) {
      return [];
    }
  }
  function guarda(lista) {
    try {
      localStorage.setItem(CLAVE, JSON.stringify(lista));
    } catch (e) {}
  }

  var lista = lee();
  var plegada = false;

  function bandeja() {
    return document.querySelector("[data-sample-tray]");
  }
  function maximo() {
    var t = bandeja();
    return t ? parseInt(t.getAttribute("data-max") || "5", 10) : 5;
  }
  function clona(sel) {
    // React deja los hijos del <template> como hijos normales y no en
    // .content; el HTML estatico, en .content. Vale cualquiera de los dos.
    var t = document.querySelector(sel);
    var el = t && ((t.content && t.content.firstElementChild) || t.firstElementChild);
    return el ? el.cloneNode(true) : null;
  }

  function pintaHuecos(caja, tipo) {
    if (!caja) return;
    caja.innerHTML = "";
    for (var i = 0; i < maximo(); i++) {
      var m = lista[i];
      var el = clona(m ? "[data-tpl-" + tipo + "-lleno]" : "[data-tpl-" + tipo + "-vacio]");
      if (!el) continue;
      if (m) {
        var img = el.querySelector("img");
        if (img) {
          img.src = m.img;
          img.alt = m.name;
        }
        var nom = el.querySelector("[data-nombre]");
        if (nom) nom.textContent = m.name;
        var quita = el.querySelector("[data-sample-remove]") || (el.hasAttribute("data-sample-remove") ? el : null);
        if (quita) quita.setAttribute("data-sample-remove", m.id);
      }
      caja.appendChild(el);
    }
  }

  function pinta() {
    var t = bandeja();
    if (!t) return;
    var n = lista.length;
    t.classList.toggle("hidden", n === 0);
    t.setAttribute("data-plegada", plegada ? "si" : "no");
    document.querySelectorAll("[data-sample-count]").forEach(function (c) {
      c.textContent = c.getAttribute("data-template").replace("{n}", n).replace("{max}", maximo());
    });
    var precio = parseFloat(t.getAttribute("data-price") || "0");
    document.querySelectorAll("[data-sample-total]").forEach(function (c) {
      c.textContent = c.getAttribute("data-template").replace("{total}", String(n * precio).replace(".", ","));
    });
    pintaHuecos(t.querySelector("[data-sample-slots]"), "bandeja");
    pintaHuecos(document.querySelector("[data-sample-drawer-slots]"), "cajon");
    var lleno = document.querySelector("[data-sample-full]");
    if (lleno) lleno.classList.add("hidden");
    document.querySelectorAll("[data-sample-add]").forEach(function (b) {
      var esta = lista.some(function (m) {
        return m.id === b.getAttribute("data-sample-id");
      });
      b.setAttribute("aria-pressed", esta ? "true" : "false");
      var txt = b.querySelector("[data-sample-label]") || b;
      txt.textContent = b.getAttribute(esta ? "data-label-added" : "data-label-add");
    });
  }

  function abreCajon(si) {
    var c = document.querySelector("[data-sample-drawer]");
    if (!c) return;
    c.setAttribute("data-state", si ? "open" : "closed");
    document.documentElement.style.overflow = si ? "hidden" : "";
  }

  document.addEventListener("click", function (e) {
    var add = e.target.closest("[data-sample-add]");
    if (add) {
      e.preventDefault();
      var id = add.getAttribute("data-sample-id");
      var i = lista.findIndex(function (m) {
        return m.id === id;
      });
      if (i >= 0) lista.splice(i, 1);
      else if (lista.length >= maximo()) {
        pinta();
        var lleno = document.querySelector("[data-sample-full]");
        if (lleno) lleno.classList.remove("hidden");
        plegada = false;
        return;
      } else lista.push({ id: id, name: add.getAttribute("data-sample-name"), img: add.getAttribute("data-sample-img") });
      plegada = false;
      guarda(lista);
      pinta();
      return;
    }
    var quita = e.target.closest("[data-sample-remove]");
    if (quita) {
      var qid = quita.getAttribute("data-sample-remove");
      lista = lista.filter(function (m) {
        return m.id !== qid;
      });
      guarda(lista);
      pinta();
      return;
    }
    if (e.target.closest("[data-sample-clear]")) {
      lista = [];
      guarda(lista);
      pinta();
      return;
    }
    if (e.target.closest("[data-sample-fold]")) {
      plegada = !plegada;
      pinta();
      return;
    }
    if (e.target.closest("[data-sample-open]")) {
      abreCajon(true);
      return;
    }
    if (e.target.closest("[data-sample-close]")) abreCajon(false);
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") abreCajon(false);
  });

  function arranca() {
    pinta();
    // Next pinta de nuevo las fichas al navegar: se repinta al cambiar el DOM.
    var t = 0;
    // Los cambios dentro de la bandeja y el cajon los hace pinta(): no cuentan.
    new MutationObserver(function (cambios) {
      var fuera = cambios.some(function (c) {
        var el = c.target.nodeType === 1 ? c.target : c.target.parentElement;
        return el && !el.closest("[data-sample-tray], [data-sample-drawer], [data-sample-add]");
      });
      if (!fuera) return;
      clearTimeout(t);
      t = setTimeout(pinta, 80);
    }).observe(document.body, { childList: true, subtree: true });
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", arranca);
  else arranca();
})();
</script>