n:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 640px) 33vw, 100vw" src="data:image/webp;base64,"></span><span class="relative block aspect-[2/3] overflow-hidden rounded-foto bg-surface-deep" style="max-width:1076px"><img alt="Detalle de una alfombra Strata 05 con una revista" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 640px) 33vw, 100vw" src="data:image/webp;base64,"></span><span class="relative block aspect-[2/3] overflow-hidden rounded-foto bg-surface-deep" style="max-width:1076px"><img alt="Alfombra Strata 07 con una revista abierta" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 640px) 33vw, 100vw" src="data:image/webp;base64,"></span></div></div><div class="mx-auto mt-14 max-w-[1000px] space-y-5 px-5 text-center md:mt-20"><p class="font-display text-[clamp(1rem,1.2vw,1.125rem)] leading-[1.65] font-extralight text-foreground">En colaboración con Rols Carpets han desarrollado la colección Strata, un homenaje a la belleza eterna de nuestro planeta. Cada pieza es un testimonio del tapiz de la Tierra, una narrativa tejida a través de los años, capturada en los colores y texturas de las piezas de alfombras. Pero estas alfombras no solo representan la belleza de la Tierra, sino también nuestro compromiso con su cuidado. Cada alfombra de la colección «Strata» está confeccionada con hilatura creada a partir de PET postconsumo.</p></div><div class="mx-auto mt-16 grid max-w-[1200px] items-center gap-10 px-5 md:mt-24 md:grid-cols-12 md:gap-x-12 md:px-10"><span class="relative block aspect-[900/530] overflow-hidden rounded-foto bg-surface-deep md:col-span-7"><img alt="Wallace &amp; Sewell" decoding="async" data-nimg="fill" class="object-cover grayscale" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 768px) 55vw, 100vw" src="data:image/webp;base64,"></span><div class="md:col-span-5"><span class="font-header text-[10px] font-medium tracking-[0.25em] text-foreground/40 uppercase">Conoce al diseñador</span><h2 class="mt-4 font-display text-[clamp(1.75rem,2.6vw,2.4rem)] leading-[1.05] font-extralight tracking-[-0.025em]">Wallace &amp; Sewell</h2><p class="mt-5 text-[12.5px] leading-[1.85] font-light text-foreground/65 md:text-[13px]">Wallace &amp; Sewell es un estudio de diseño de textiles fundado por Harriet Wallace-Jones y Emma Sewell. Reconocidas por su enfoque en la combinación de colores y texturas, Wallace &amp; Sewell ha logrado un equilibrio entre la tradición y la modernidad que ha llevado a colaboraciones con algunas de las marcas más respetadas en el mundo del diseño.</p></div></div><div class="mt-16 px-5 md:mt-24 md:px-10 lg:px-16"><video src="strata-video.mp4" poster="data:image/webp;base64," autoPlay="" muted="" loop="" playsInline="" preload="metadata" aria-label="Vídeo de la colección Strata de Wallace &amp; Sewell para Rols" class="mx-auto block h-auto w-full rounded-foto bg-surface-deep" style="max-width:min(1280px, calc(78svh * 2.051282051282051));aspect-ratio:1280 / 624"></video></div></div><section class="mx-auto mt-20 max-w-[1320px] md:mt-28"><h2 class="sr-only">Colección Strata</h2><div class="mb-12 text-center md:mb-16"><span class="font-header text-[10px] font-medium tracking-[0.25em] text-foreground/40 uppercase block">Strata</span><p class="mt-3 font-display text-[clamp(1.45rem,2vw,1.75rem)] leading-[1.2] font-extralight tracking-[-0.015em]">Ocho colores, el tapiz de la Tierra</p></div><ul class="mx-auto flex list-none flex-wrap justify-center gap-x-6 gap-y-12 md:gap-x-10 [&amp;&gt;li]:w-[calc(50%-0.75rem)] sm:[&amp;&gt;li]:w-[220px] max-w-[1000px]"><li data-rug-card="true" data-colors="otros" data-qualities="aptaParaSueloRadiante usoContractIn